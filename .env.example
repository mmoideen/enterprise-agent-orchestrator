# Database Configuration
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/enterprise_agents
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=enterprise-agents

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# Security
SECRET_KEY=change-me-in-production-use-cryptographically-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Governance
POLICY_CONFIG_PATH=./config/policies.yaml
RISK_SCORE_THRESHOLD=0.75
PII_DETECTION_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Agent Runtime
AGENT_EXECUTION_TIMEOUT_SECONDS=300
MAX_CONCURRENT_AGENTS=10

# MCP Configuration
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=8001
